Load the CPU backend through the ggml registry in llama-export-lora.

ggml_backend_cpu_init() is not exported when backends are dlopen'd.

--- a/tools/CMakeLists.txt	2026-10-28 12:30:38.000000000 +0100
+++ b/tools/CMakeLists.txt	2026-10-29 04:04:31.410558810 +0100
@@ -35,10 +35,12 @@
     if (LLAMA_CONNECT)
         add_subdirectory(connect)
     endif()
+    # export-lora loads the CPU backend through the registry, so it also
+    # works when backends are dlopen'd (system libggml).
+    add_subdirectory(export-lora)
     if (NOT GGML_BACKEND_DL AND GGML_CPU)
-        # these tools use backends directly (no dynamic loading) and depend on CPU backend symbols
+        # uses CPU backend symbols directly (no dynamic loading)
         add_subdirectory(cvector-generator)
-        add_subdirectory(export-lora)
     endif()
     add_subdirectory(fit-params)
     if (GGML_METAL)
--- a/tools/export-lora/export-lora.cpp	2026-10-28 12:30:38.000000000 +0100
+++ b/tools/export-lora/export-lora.cpp	2026-10-29 04:04:31.394606782 +0100
@@ -1,5 +1,6 @@
 #include "ggml.h"
 #include "ggml-alloc.h"
+#include "ggml-backend.h"
 #include "gguf.h"
 
 #include "arg.h"
@@ -157,7 +158,15 @@
             /*.no_alloc   =*/ true,
         };
         ctx_out_ggml = ggml_init(params);
-        backend = ggml_backend_cpu_init();
+        // Works with a linked libggml-cpu and with GGML_BACKEND_DL plugins
+        // (system libggml). ggml_backend_cpu_init() is not exported by libggml.
+        ggml_backend_load_all();
+        backend = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+        if (!backend) {
+            throw std::runtime_error(
+                "failed to initialize CPU backend "
+                "(install a ggml-backend-cpu* plugin)");
+        }
         allocr = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
     }
 
@@ -379,7 +388,15 @@
         // compute
         {
             ggml_gallocr_alloc_graph(allocr, gf);
-            ggml_backend_cpu_set_n_threads(backend, n_threads);
+            ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+            if (dev) {
+                ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+                auto set_n_threads_fn = (ggml_backend_set_n_threads_t)
+                    ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+                if (set_n_threads_fn) {
+                    set_n_threads_fn(backend, n_threads);
+                }
+            }
             ggml_backend_graph_compute(backend, gf);
         }
 
