diff -Nru a/tools/export-lora/export-lora.cpp b/tools/export-lora/export-lora.cpp
--- a/tools/export-lora/export-lora.cpp	2026-08-16 14:12:55.000000000 +0200
+++ b/tools/export-lora/export-lora.cpp	2026-08-18 11:21:17.850455886 +0200
@@ -1,5 +1,6 @@
 #include "ggml.h"
 #include "ggml-alloc.h"
+#include "ggml-backend.h"
 #include "gguf.h"
 
 #include "arg.h"
@@ -154,7 +155,15 @@
             /*.no_alloc   =*/ true,
         };
         ctx_out_ggml = ggml_init(params);
