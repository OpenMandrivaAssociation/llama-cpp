+// Apertus emits <|tools_prefix|>[{"name": args}]<|tools_suffix|>. The generated PEG
+// often leaves the closer unparsed and does not map function-as-key JSON into
+// tool_calls. Recover so the OpenAI API gets structured calls instead of a 500.
+static void recover_apertus_tool_calls(common_chat_msg & msg, const std::string & raw = {}) {
+    if (!msg.tool_calls.empty()) {
+        return;
+    }
+    const std::string & src = !msg.content.empty() ? msg.content : raw;
+    if (src.empty()) {
+        return;
+    }
+    const std::string open  = "<|tools_prefix|>";
+    const std::string close = "<|tools_suffix|>";
+    const auto        start = src.find(open);
+    if (start == std::string::npos) {
+        return;
+    }
+    const auto end = src.find(close, start + open.size());
+    if (end == std::string::npos) {
+        return;
+    }
+    std::string body = src.substr(start + open.size(), end - start - open.size());
+    while (!body.empty() && std::isspace(static_cast<unsigned char>(body.front()))) {
+        body.erase(body.begin());
+    }
+    while (!body.empty() && std::isspace(static_cast<unsigned char>(body.back()))) {
+        body.pop_back();
+    }
+    json parsed;
+    try {
+        parsed = json::parse(body);
+    } catch (...) {
+        return;
+    }
+    if (parsed.is_object()) {
+        parsed = json::array({ parsed });
+    }
+    if (!parsed.is_array()) {
+        return;
+    }
+    for (const auto & item : parsed) {
+        if (!item.is_object()) {
+            continue;
+        }
+        if (item.contains("name")) {
+            common_chat_tool_call tc;
+            tc.name = item.at("name").is_string() ? item.at("name").get<std::string>() : item.at("name").dump();
+            if (item.contains("arguments")) {
+                const auto & args = item.at("arguments");
+                tc.arguments      = args.is_string() ? args.get<std::string>() : args.dump();
+            } else {
+                tc.arguments = "{}";
+            }
+            msg.tool_calls.push_back(std::move(tc));
+            continue;
+        }
+        for (const auto & el : item.items()) {
+            common_chat_tool_call tc;
+            tc.name      = el.key();
+            tc.arguments = el.value().is_string() ? el.value().template get<std::string>() : el.value().dump();
+            msg.tool_calls.push_back(std::move(tc));
+        }
+    }
+    if (msg.tool_calls.empty()) {
+        return;
+    }
+    std::string prefix = src.substr(0, start);
+    while (!prefix.empty() && std::isspace(static_cast<unsigned char>(prefix.back()))) {
+        prefix.pop_back();
+    }
+    msg.content = std::move(prefix);
+}
